[include]
	path = ~/.gitconfig.local
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[alias]
	st = status
	co = checkout
	br = branch
	lg = log --graph --oneline --decorate --all
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[fetch]
	prune = true
[pull]
	rebase = true
[rerere]
	enabled = true
