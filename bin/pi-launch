#!/usr/bin/env node
// Keep worktree lifecycle handling outside Pi so it also applies to resumed sessions.
import { closeSync, openSync, readSync, readdirSync, realpathSync } from 'node:fs';
import { homedir } from 'node:os';
import { basename, dirname, join, resolve } from 'node:path';
import { spawnSync } from 'node:child_process';

const args = process.argv.slice(2);
let cwd = process.cwd();
const interactive = process.stdin.isTTY && process.stdout.isTTY;

function git(directory, ...argv) {
  const result = spawnSync('git', ['-C', directory, ...argv], { encoding: 'utf8' });
  return result.status === 0 ? result.stdout.trimEnd() : undefined;
}

function prompt(message) {
  process.stderr.write(message);
  const byte = Buffer.alloc(1);
  let answer = '';
  while (readSync(0, byte, 0, 1, null) && byte[0] !== 10) answer += byte.toString();
  return answer.trim().toLowerCase();
}

function worktree(directory) {
  const root = git(directory, 'rev-parse', '--show-toplevel');
  const common = git(directory, 'rev-parse', '--git-common-dir');
  if (!root || !common) return;
  const commonPath = realpathSync(resolve(directory, common));
  if (basename(commonPath) !== '.git') return;
  const main = dirname(commonPath);
  const path = realpathSync(root);
  const branch = git(path, 'symbolic-ref', '--quiet', '--short', 'HEAD');
  // Only manage the sibling pi/<name> worktrees created by pi-worktree.
  if (!branch?.startsWith('pi/')) return;
  const name = branch.slice(3);
  if (path !== join(dirname(main), `${basename(main)}-${name}`) || path === main) return;
  return { path, main, branch, name };
}

// Read only the session header, never conversation entries or credentials.
function sessionHeader(path) {
  let fd;
  try {
    fd = openSync(path, 'r');
    const byte = Buffer.alloc(1);
    const bytes = [];
    while (bytes.length < 16384 && readSync(fd, byte, 0, 1, null)) {
      if (byte[0] === 10) break;
      bytes.push(byte[0]);
    }
    if (byte[0] !== 10) return;
    const header = JSON.parse(Buffer.from(bytes).toString());
    if (header.type === 'session' && typeof header.cwd === 'string' && typeof header.id === 'string') {
      return { path, cwd: header.cwd, id: header.id };
    }
  } catch {
    // Let Pi report missing or invalid sessions itself.
  } finally {
    if (fd !== undefined) closeSync(fd);
  }
}

function expandHome(path) {
  return path.startsWith('~/') ? join(homedir(), path.slice(2)) : path;
}

function option(name) {
  const end = args.indexOf('--');
  const index = args.indexOf(name);
  return index >= 0 && (end < 0 || index < end) ? index : -1;
}

function resolveSession(value) {
  if (value.includes('/') || value.includes('\\') || value.endsWith('.jsonl')) {
    return sessionHeader(resolve(cwd, expandHome(value)));
  }
  const dirIndex = option('--session-dir');
  const custom = dirIndex >= 0 ? args[dirIndex + 1] : process.env.PI_CODING_AGENT_SESSION_DIR;
  const base = custom
    ? resolve(cwd, expandHome(custom))
    : join(process.env.PI_CODING_AGENT_DIR || join(homedir(), '.pi', 'agent'), 'sessions');
  const candidates = [];
  function scan(directory, nested) {
    let entries;
    try { entries = readdirSync(directory, { withFileTypes: true }); } catch { return; }
    for (const entry of entries) {
      const path = join(directory, entry.name);
      if (entry.isDirectory() && nested) scan(path, false);
      if (!entry.isFile() || !entry.name.endsWith('.jsonl')) continue;
      const header = sessionHeader(path);
      if (header?.id.startsWith(value)) candidates.push(header);
    }
  }
  scan(base, !custom);
  const local = candidates.filter((candidate) => candidate.cwd === cwd);
  const pool = local.length ? local : candidates;
  const exact = pool.filter((candidate) => candidate.id === value);
  const matches = exact.length ? exact : pool;
  // Avoid silently choosing the wrong worktree for an ambiguous prefix.
  return matches.length === 1 ? matches[0] : undefined;
}

const sessionIndex = option('--session');
const oneShot = ['--print', '-p', '--mode', '--help', '-h', '--version', '-v', '--export', '--list-models']
  .some((flag) => option(flag) >= 0)
  || ['install', 'remove', 'uninstall', 'update', 'list', 'config', 'auth', 'mcp'].includes(args[0]);
// Explicit --fork remains Pi's responsibility. Never prompt in protocol/print modes.
if (interactive && !oneShot && sessionIndex >= 0 && option('--fork') < 0) {
  const value = args[sessionIndex + 1];
  const session = value ? resolveSession(value) : undefined;
  const target = session ? worktree(session.cwd) : undefined;
  const currentCommon = git(cwd, 'rev-parse', '--git-common-dir');
  const sameRepo = target && currentCommon && realpathSync(resolve(cwd, currentCommon)) === join(target.main, '.git');
  if (sameRepo && realpathSync(cwd) !== realpathSync(session.cwd)) {
    const answer = prompt(`Session belongs to worktree: ${session.cwd}\n[s] Switch there and continue (default)\n[f] Fork into current directory\n[c] Cancel\nChoice [s/f/c]: `);
    if (answer === '' || answer === 's') {
      cwd = session.cwd;
      args[sessionIndex + 1] = session.path;
      // Relative storage paths must keep their original meaning after switching.
      const dirIndex = option('--session-dir');
      if (dirIndex >= 0 && args[dirIndex + 1]) args[dirIndex + 1] = resolve(process.cwd(), expandHome(args[dirIndex + 1]));
      if (process.env.PI_CODING_AGENT_SESSION_DIR) {
        process.env.PI_CODING_AGENT_SESSION_DIR = resolve(process.cwd(), expandHome(process.env.PI_CODING_AGENT_SESSION_DIR));
      }
    } else if (answer === 'f') {
      args[sessionIndex] = '--fork';
      args[sessionIndex + 1] = session.path;
    } else {
      process.exit(0);
    }
  }
}

const managed = interactive && !oneShot ? worktree(cwd) : undefined;
const result = spawnSync('pi', args, { cwd, stdio: 'inherit' });
if (result.error) process.stderr.write(`pi-launch: ${result.error.message}\n`);

// Revalidate after Pi exits: the agent may have switched branches or removed it.
if (managed && !result.error && worktree(cwd)?.branch === managed.branch) {
  const dirty = git(managed.path, 'status', '--porcelain');
  if (dirty !== undefined) {
    if (dirty) process.stderr.write(`\n⚠️  Worktree "${managed.name}" has uncommitted changes:\n${dirty.split('\n').slice(0, 20).join('\n')}\n`);
    const answer = prompt(`\n${dirty ? 'Force-remove' : 'Remove'} worktree "${managed.name}" and branch ${managed.branch} on exit? [y/N] `);
    if (answer === 'y' || answer === 'yes') {
      const removed = spawnSync('git', ['-C', managed.main, 'worktree', 'remove', ...(dirty ? ['--force'] : []), managed.path], { stdio: 'inherit' });
      if (removed.status === 0) {
        const deleted = spawnSync('git', ['-C', managed.main, 'branch', '-D', managed.branch], { stdio: 'inherit' });
        process.stderr.write(deleted.status === 0 ? `✓ removed ${managed.path}\n` : `Worktree removed; branch ${managed.branch} retained (deletion failed).\n`);
      } else {
        process.stderr.write('Worktree removal failed; branch retained.\n');
      }
    } else {
      process.stderr.write(`Kept "${managed.name}" — resume with: pi -w ${managed.name} --continue\n`);
    }
  }
}
process.exit(result.status ?? (result.signal === 'SIGINT' ? 130 : result.signal === 'SIGTERM' ? 143 : 1));
